# Copy to .env and fill the values you have. Missing keys disable the
# corresponding feature gracefully (the server still boots).

# Local database location (SQLite file). Auto-created on first run.
PKM_DB_PATH=./pkm.db

# --- Notion ---
# Internal integration token (https://www.notion.so/my-integrations).
NOTION_TOKEN=
# Optional: comma-separated database IDs to sync. Empty = search all
# pages shared with the integration.
NOTION_DATABASE_IDS=

# --- Anthropic (LLM tagging + cluster summaries) ---
ANTHROPIC_API_KEY=
PKM_LLM_MODEL=claude-sonnet-4-6

# --- Voyage (embeddings) ---
# If unset, the store uses a deterministic hashing-based fallback so the
# server still runs end-to-end (lower quality, but no API needed).
VOYAGE_API_KEY=
PKM_EMBED_MODEL=voyage-3
