# Copy to .env (in repo root) and fill values. Do NOT commit real secrets.

# --- Telegram (REQUIRED) ---
# Get this from @BotFather. Without it the bot cannot start.
HERMES_BOT_TOKEN=123456:ABC-your-bot-token

# Group/chat IDs for notifications and the scheduled digest.
# Comma-separated. Group IDs are negative; supergroups start with -100.
# Use the /id command in the target group to discover this value.
HERMES_NOTIFY_CHAT_IDS=-1001234567890

# Optional allowlist. If set, only these chat IDs may use the bot.
# Leave empty to allow any chat.
HERMES_ALLOWED_CHAT_IDS=

# --- LLM (optional; enables /ask and AI conversation) ---
# OpenAI-compatible chat completions endpoint.
LLM_API_KEY=your_api_key_here
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
HERMES_SYSTEM_PROMPT=You are Hermes, a concise assistant for an IVDR regulatory document automation team.

# --- IVDR backend (optional; enables /status and the digest) ---
# Base URL including the /api prefix.
HERMES_IVDR_API_URL=http://localhost:8000/api

# --- Scheduling (optional) ---
# Seconds between automatic status digests. 0 disables it.
HERMES_DIGEST_INTERVAL_SECONDS=0
